# 复制为 .env 后按需修改。所有敏感值均通过环境变量注入，绝不写入代码或提交仓库。

# 加密主密钥：AES-256-GCM 需要 32 字节。生成：openssl rand -base64 32
# 同时用于签发登录 token（派生独立子密钥）。
LUMINA_MASTER_KEY=change-me-to-a-32-byte-random-key!!

# 服务端口（API 与 Web 同端口，单进程托管）
PORT=8787

# SQLite 数据文件路径（相对或绝对）。数据完全自持，请定期备份此文件。
LUMINA_DB_PATH=./data/lumina.db

# ── 互助池策略 ──
# 受助者每日最多请求次数（互助模式）
LUMINA_POOL_DAILY_LIMIT=60

# ── 提供商默认配置（JSON，可覆盖内置默认；base_url/model 均可自定义）──
# 内置：deepseek / qwen / zhipu / gemini；Key 亦可单独填 custom base_url + model
# LUMINA_PROVIDERS={"deepseek":{"baseUrl":"https://api.deepseek.com/v1","defaultModel":"deepseek-chat"}}

# ── 开发/演示：启用内置 mock 提供商（无需真实 Key 即可体验全流程）──
LUMINA_MOCK=false

# CORS 允许来源（开发时前端与 API 分端口；生产同源无需配置）
# LUMINA_CORS_ORIGIN=http://localhost:5173
