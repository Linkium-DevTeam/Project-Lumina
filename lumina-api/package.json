{
  "name": "@linkium-suki/lumina-api",
  "version": "2.0.0",
  "description": "微光 Lumina 服务端 — AI 编排 + 互助池协议 + 密钥加密（单进程自托管，内置前端）",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkium-suki/Project-Lumina.git",
    "directory": "lumina-api"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "web-dist",
    "bin.mjs",
    "README.md"
  ],
  "bin": {
    "lumina": "bin.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "^3.1.4"
  }
}
